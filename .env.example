# Copy this file to .env and fill in what you have. Never commit .env.
ARCHIL_API_KEY=
ARCHIL_REGION=
# Optional
KEENABLE_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI reads what people type in the chat (request, start reply, plan pick); model via OPENAI_MODEL
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Force a parser: openai, claude or rules (default: openai if its key is set, else claude, else rules)
# PLANNER_PARSER=openai
# overpass.ch: fast OpenStreetMap venue search and geocoding (falls back to public Nominatim/Overpass)
OVERPASS_CH_KEY=
# SubQ Snap decides which plans to show (console.subq.ai; free 100M tokens for new accounts)
SUBQ_API_KEY=
# Force a decider: rules, claude or subq (default: subq if its key is set, else claude, else rules)
# PLANNER_DECIDER=subq
# PLANNER_SEARCH=keenable
# Run every route branch in its own Archil sandbox (needs ARCHIL_API_KEY, ARCHIL_DISK_ID)
# PLANNER_ROUTES=sandboxes
